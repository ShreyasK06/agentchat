# Copy to ~/.agentchat/.env on every machine that runs a Claude session. Never commit the real file.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Shared "join" secret; must equal the AGENTCHAT_INVITE secret set on the Edge Function.
AGENTCHAT_INVITE=change-me-long-random-string

# Optional per-session overrides (usually set in .mcp.json instead):
# AGENTCHAT_NAME=researcher
# AGENTCHAT_PROJECT=milling-research
